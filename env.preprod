# Copier en .env sur le serveur preprod (jamais commité)

# Variables "globales" (en CI: niveau repository, pas par environnement)
IMAGE_NAME=brice99/tnbswitch-backend
DB_HOST=host.docker.internal
KAFKA_BROKERS=host.docker.internal:9092

IMAGE_TAG=preprod
CONTAINER_NAME=tnbswitch-backend-preprod

SPRING_PROFILES_ACTIVE=preprod
SERVER_PORT=8083
MANAGEMENT_SERVER_PORT=8092

# Topics Kafka isolés par environnement (ex: tnb.preprod.withdrawal.commands) + groupe de consommateurs distinct
KAFKA_TOPIC_PREFIX=tnb.preprod
KAFKA_CONSUMER_GROUP_ID=tnbswitch-backend-preprod

# Base dédiée preprod, distincte de dev/prod
DB_PORT=5432
DB_NAME=tnb-switch-preprod
DB_USER=brice
DB_PASSWORD=

# Générer avec : openssl rand -hex 64 (secrets distincts de dev et de prod)
JWT_SECRET=
DEVICE_JWT_SECRET=

SMS_PROVIDER=mock
SEED_ADMIN_ENABLED=false
SEED_ADMIN_PHONE_NUMBER=+237658734332
IA_RECONCILIATION_URL=http://localhost:8091/api
