# Copier en .env sur le serveur de prod (jamais commité)

# Variables "globales" (en CI: niveau repository, pas par environnement)
IMAGE_NAME=brice99/tnbswitch-backend
DB_HOST=host.docker.internal
KAFKA_BROKERS=kafka:29092

IMAGE_TAG=prod
CONTAINER_NAME=tnbswitch-backend-prod

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8084
MANAGEMENT_SERVER_PORT=8093

# Topics Kafka isolés par environnement (ex: tnb.prod.withdrawal.commands) + groupe de consommateurs distinct
KAFKA_TOPIC_PREFIX=tnb.prod
KAFKA_CONSUMER_GROUP_ID=tnbswitch-backend-prod

# Base dédiée prod, distincte de dev/preprod
DB_PORT=5432
DB_NAME=tnb-switch-prod
DB_USER=brice
DB_PASSWORD=

# Générer avec : openssl rand -hex 64 (secrets distincts de dev et de preprod, à faire tourner régulièrement)
JWT_SECRET=
DEVICE_JWT_SECRET=

SMS_PROVIDER=mock
SEED_ADMIN_ENABLED=false
SEED_ADMIN_PHONE_NUMBER=+237658734332
IA_RECONCILIATION_URL=http://localhost:8091/api
