# Copier en .env sur le serveur/poste de dev (jamais commité)

# Variables "globales" (en CI: niveau repository, pas par environnement)
IMAGE_NAME=brice99/tnbswitch-backend
DB_HOST=host.docker.internal
KAFKA_BROKERS=host.docker.internal:9092

IMAGE_TAG=dev
CONTAINER_NAME=tnbswitch-backend-dev

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8082
MANAGEMENT_SERVER_PORT=8091

# Topics Kafka isolés par environnement (ex: tnb.dev.withdrawal.commands) + groupe de consommateurs distinct
KAFKA_TOPIC_PREFIX=tnb.dev
KAFKA_CONSUMER_GROUP_ID=tnbswitch-backend-dev

# Postgres natif du VPS (postgresql@18-main), atteint via host.docker.internal
DB_PORT=5432
DB_NAME=tnb-switch-dev
DB_USER=brice
DB_PASSWORD=

# Générer avec : openssl rand -hex 64 (deux valeurs distinctes, ne jamais réutiliser celles de application.properties)
JWT_SECRET=
DEVICE_JWT_SECRET=

SMS_PROVIDER=mock
SEED_ADMIN_ENABLED=true
SEED_ADMIN_PHONE_NUMBER=+237658734332
IA_RECONCILIATION_URL=http://localhost:8083/api
